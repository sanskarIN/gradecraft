{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GradeCraft",
  "version": "../package.json",
  "identifier": "in.sanskar.gradecraft",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "GradeCraft",
        "width": 1200,
        "height": 800,
        "minWidth": 360,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Education",
    "shortDescription": "Privacy-first student grade calculator",
    "longDescription": "GradeCraft is a privacy-first, offline-capable student grade calculator for web, desktop, and mobile.",
    "license": "MIT",
    "licenseFile": "../LICENSE",
    "android": {
      "minSdkVersion": 24
    },
    "iOS": {
      "minimumSystemVersion": "14.0"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
