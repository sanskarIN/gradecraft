{
  "name": "gradecraft",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Privacy-first student grade calculator PWA.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint . --max-warnings=0",
    "format:check": "node scripts/check-format.mjs",
    "format": "node scripts/check-format.mjs",
    "docs:links": "node scripts/check-doc-links.mjs",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm run docs:links && npm run security:secrets && npm run test && npm run build",
    "security:secrets": "node scripts/check-secrets.mjs"
  },
  "engines": { "node": ">=20.19.0" },
  "dependencies": { "react": "19.0.0", "react-dom": "19.0.0" },
  "devDependencies": {
    "@eslint/js": "9.17.0", "@playwright/test": "1.49.1", "@testing-library/jest-dom": "6.6.3", "@testing-library/react": "16.1.0",
    "@types/react": "19.0.3", "@types/react-dom": "19.0.2", "@vitejs/plugin-react": "4.3.4", "@vitest/coverage-v8": "3.0.5",
    "eslint": "9.17.0", "eslint-plugin-react-hooks": "5.1.0", "eslint-plugin-react-refresh": "0.4.16", "jsdom": "26.0.0",
    "typescript": "5.7.2", "typescript-eslint": "8.18.2", "vite": "6.0.7", "vitest": "3.0.5", "@types/node": "22.10.2"
  }
}
