{
  "name": "gradecraft",
  "private": true,
  "version": "2.0.12",
  "type": "module",
  "description": "Privacy-first student grade calculator for web, desktop, and mobile.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint . --max-warnings=0",
    "format:check": "node scripts/check-format.mjs",
    "format": "node scripts/check-format.mjs",
    "docs:links": "node scripts/check-doc-links.mjs",
    "version:check": "node scripts/check-version-sync.mjs",
    "release:gate": "node scripts/check-release-gate.mjs",
    "release:tag": "node scripts/check-release-tag.mjs",
    "perf:budget": "node scripts/check-bundle-budget.mjs",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm run docs:links && npm run security:secrets && npm run version:check && npm run release:gate && npm run test && npm run build && npm run perf:budget",
    "security:secrets": "node scripts/check-secrets.mjs",
    "native": "tauri",
    "native:icons": "tauri icon public/icons/icon.svg",
    "native:dev": "npm run native:icons && tauri dev",
    "native:build": "npm run native:icons && tauri build",
    "native:check": "npm run native:icons && cargo check --manifest-path src-tauri/Cargo.toml",
    "android:init": "npm run native:icons && tauri android init",
    "android:dev": "npm run native:icons && tauri android dev",
    "android:build": "npm run native:icons && tauri android build",
    "ios:init": "npm run native:icons && tauri ios init",
    "ios:dev": "npm run native:icons && tauri ios dev",
    "ios:build": "npm run native:icons && tauri ios build"
  },
  "engines": { "node": ">=20.19.0" },
  "dependencies": {
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-dialog": "2.7.2",
    "@tauri-apps/plugin-fs": "2.5.1",
    "react": "19.0.0",
    "react-dom": "19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "9.17.0",
    "@playwright/test": "1.49.1",
    "@tauri-apps/cli": "2.11.4",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.1.0",
    "@types/react": "19.0.3",
    "@types/react-dom": "19.0.2",
    "@vitejs/plugin-react": "4.3.4",
    "@vitest/coverage-v8": "3.0.5",
    "eslint": "9.17.0",
    "eslint-plugin-react-hooks": "5.1.0",
    "eslint-plugin-react-refresh": "0.4.16",
    "jsdom": "26.0.0",
    "typescript": "5.7.2",
    "typescript-eslint": "8.18.2",
    "vite": "6.0.7",
    "vitest": "4.1.10",
    "@types/node": "22.10.2"
  }
}
